<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_inherit_inventory_pallet" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.inventory.pallet</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <!-- Insertamos después del último bloque de configuración -->
                <xpath expr="//div[contains(@class,'app_settings_block')][last()]" position="after">
                    <div class="app_settings_block" data-group="snva_packing_simulation">
                        <h2>SNVA - Packing Simulation</h2>

                        <!-- Campo: Token de licencia -->
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="snva_packing_license_token"/>
                                    <div class="text-muted">
                                        License token used by the Packing viewer.
                                    </div>
                                    <field name="snva_packing_license_token" placeholder="Ej: QCO0X727Q2XI"/>
                                </div>
                            </div>
                        </div>

                        <!-- Campo O2M: configuración de mapeo de campos -->
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="snva_pallet_product_config_ids"/>
                                    <div class="text-muted">
                                        Add the product dimension field mappings to use for simulation (width, height, etc).
                                    </div>
                                    <field name="snva_pallet_product_config_ids" invisible="1"
                                        mode="tree"
                                        create="0" edit="0" delete="0"
                                        readonly="1"
                                        nolabel="1"
                                        context="{'force_company': company_id}"
                                        domain="[('snva_product_ref_company_id','=', company_id)]">

                                        <!-- Vista tipo lista solo lectura -->
                                        <tree string="Pallet Mapping" editable="false">
                                            <field name="snva_product_ref_name"/>
                                            <field name="snva_product_ref_width"/>
                                            <field name="snva_product_ref_height"/>
                                            <field name="snva_product_ref_length"/>
                                            <field name="snva_product_ref_weight"/>
                                            <field name="snva_product_ref_company_id" groups="base.group_system"/>
                                        </tree>
                                    </field>

                                    <!-- Botón personalizado para abrir el formulario de creación -->
                                    <button name="%(action_snva_product_pallet_config)d"
                                        type="action"
                                        string="Add Pallet Mapping"
                                        class="btn btn-primary mt16"
                                        context="{
                                            'default_snva_product_ref_company_id': company_id,
                                            'force_company': company_id
                                        }"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
